{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Liga das Lendas Assist",
  "version": "0.2.0",
  "identifier": "com.daltonfontes.ligadaslendasassist",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Liga das Lendas Assist",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' champ: http://champ.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Assistente de partida para League of Legends",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
