{
  "name": "liga-das-lendas-assist",
  "version": "0.1.0",
  "description": "Assistente de partida para League of Legends usando a API local do cliente (LCU) e a Live Client Data API.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}
